# ───────────────────────────────────
# StageIA — Frontend (Next.js)
# Copier ce fichier en ".env.local" et adapter les valeurs
# ───────────────────────────────────

# URL de l'API backend (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3020

# Clé API Groq (utilisée côté serveur dans /app/api/chat et /app/api/ai-progress)
GROQ_API_KEY=votre_cle_api_groq