# ───────────────────────────────────
# StageIA — Backend (NestJS)
# Copier ce fichier en ".env" et adapter les valeurs
# ───────────────────────────────────

# Port HTTP de l'API
PORT=3020

# Environnement d'exécution (development / production)
NODE_ENV=development

# Base de donnees PostgreSQL
#
# Option 1 (base distante type Neon) : URL unique, prioritaire sur les champs DB_* ci-dessous.
#   Ne pas inclure "sslmode" ni "channel_binding" : le SSL est force dans le code.
# DATABASE_URL=postgresql://user:password@host/database
#
# Option 2 (base locale) : utilisee uniquement si DATABASE_URL est absente/commentee.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=stageia

# -----------------------------------
# Envoi d'emails via Resend (https://resend.com)
# Sans RESEND_API_KEY, les emails sont simules dans la console du backend.
# En mode test Resend, l'expediteur onboarding@resend.dev ne peut ecrire
# qu'a l'adresse email du proprietaire du compte Resend.
# -----------------------------------
RESEND_API_KEY=
MAIL_FROM=StageIA <onboarding@resend.dev>

# URL du frontend (utilisee pour construire les liens de reinitialisation dans les emails)
APP_URL=http://localhost:3000